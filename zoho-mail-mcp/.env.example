# Skopíruj ako .env a doplň hodnoty. Súbor .env nepatrí do gitu.

# Dátové centrum účtu: us, eu, in, au, jp, ca, sa, uk, ae, cn
# Pre schránky na onoff.sk je to takmer isto eu.
ZOHO_DC=eu

# Z api-console.zoho.eu → Self Client
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Výstup zo scripts/get_refresh_token.py
ZOHO_REFRESH_TOKEN=

# Voliteľné: obmedzí konektor na vymenované schránky (čiarkou oddelené).
# Prázdne = bez obmedzenia.
# ZOHO_ALLOWED_ACCOUNTS=jan@onoff.sk,info@onoff.sk

# Voliteľné ladenie
# ZOHO_TIMEOUT=30
# ZOHO_MAX_RETRIES=3
# ZOHO_MAX_CONTENT_CHARS=20000
