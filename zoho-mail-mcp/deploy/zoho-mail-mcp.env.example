# Skopíruj na server ako /etc/zoho-mail-mcp.env
#   chown root:root /etc/zoho-mail-mcp.env && chmod 600 /etc/zoho-mail-mcp.env
# Sú tu prístupy do firemnej pošty – nikdy to nekomituj do gitu.

# --- Zoho ---
ZOHO_DC=eu
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- sieťový režim ---
# Vygeneruj: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ZOHO_MCP_AUTH_TOKEN=

# ZeroTier adresa servera. Viaž sa priamo na ňu, nie na 0.0.0.0 –
# služba potom nie je dostupná z domácej LAN ani z internetu.
ZOHO_MCP_HOST=10.147.17.5
ZOHO_MCP_PORT=8765

# Voliteľné: obmedzí, ktoré schránky konektor vidí.
# ZOHO_ALLOWED_ACCOUNTS=jan@onoff.sk,info@onoff.sk

# --- prílohy ---
# Kam sa ukladajú stiahnuté prílohy a aká veľká smie príloha byť.
# ZOHO_DOWNLOAD_DIR=/var/lib/zoho-mail-mcp/attachments
# ZOHO_MAX_ATTACHMENT_BYTES=26214400
