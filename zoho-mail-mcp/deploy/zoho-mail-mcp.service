# systemd unit pre konektor v sieťovom režime.
#
# Najjednoduchšie je nechať to na inštalátor, ktorý si cesty doplní sám:
#     sudo bash deploy/install.sh
#
# Ručne: skopíruj tento súbor do /etc/systemd/system/, uprav cesty nižšie,
# vytvor /etc/zoho-mail-mcp.env podľa zoho-mail-mcp.env.example a spusti
#     systemctl daemon-reload && systemctl enable --now zoho-mail-mcp

[Unit]
Description=Zoho Mail MCP konektor (len na čítanie)
Documentation=https://github.com/Mambrtata/common-task
# Počká na ZeroTier, inak sa nemá na čo naviazať.
After=network-online.target zerotier-one.service
Wants=network-online.target

# Bez tohto systemd po piatich rýchlych pokusoch prestane skúšať. Služba sa
# viaže priamo na ZeroTier adresu, a kým ju ZeroTier po štarte pridelí, môže
# to trvať dlhšie – vtedy sa treba pokúšať ďalej, nie to vzdať.
StartLimitIntervalSec=0

[Service]
Type=simple
User=zoho-mcp
Group=zoho-mcp

# Tu sú tokeny – súbor nech patrí rootovi a má práva 0600.
EnvironmentFile=/etc/zoho-mail-mcp.env

# Vytvorí /var/lib/zoho-mail-mcp pre službu a nechá ho zapisovateľný
# aj pri ProtectSystem=strict. Sem sa ukladajú stiahnuté prílohy.
StateDirectory=zoho-mail-mcp
StateDirectoryMode=0750

WorkingDirectory=/opt/common-task/zoho-mail-mcp
Environment=PYTHONPATH=/opt/common-task/zoho-mail-mcp/src
ExecStart=/usr/bin/python3 -m zoho_mail_mcp --transport http

Restart=on-failure
RestartSec=10s

# Služba potrebuje len čítať svoj kód a chodiť na sieť.
# AF_UNIX tam musí byť – cez lokálny socket ide rozlišovanie mien.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
