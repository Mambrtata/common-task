# systemd unit pre konektor v sieťovom režime.
#
# 1. Skopíruj na server ako /etc/systemd/system/zoho-mail-mcp.service
# 2. Doplň cesty, ZeroTier adresu a vytvor /etc/zoho-mail-mcp.env (viď README)
# 3. systemctl daemon-reload && systemctl enable --now zoho-mail-mcp

[Unit]
Description=Zoho Mail MCP konektor (len na čítanie)
Documentation=https://github.com/Mambrtata/common-task
# Počká na ZeroTier, inak sa nemá na čo naviazať.
After=network-online.target zerotier-one.service
Wants=network-online.target

[Service]
Type=simple
User=zoho-mcp
Group=zoho-mcp

# Tu sú tokeny – súbor nech patrí rootovi a má práva 0600.
EnvironmentFile=/etc/zoho-mail-mcp.env

WorkingDirectory=/opt/common-task/zoho-mail-mcp
Environment=PYTHONPATH=/opt/common-task/zoho-mail-mcp/src
ExecStart=/usr/bin/python3 -m zoho_mail_mcp --transport http

Restart=on-failure
RestartSec=5s

# Služba potrebuje len čítať svoj kód a chodiť na sieť.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
